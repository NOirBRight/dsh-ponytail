{
  "name": "dsh-ponytail",
  "version": "0.1.0",
  "description": "Ponytail modes, skills, commands, and GUI integration for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "skills/",
    "README.md",
    "README.zh.md",
    "DESIGN.md",
    "LICENSE",
    "UPSTREAM.md"
  ],
  "scripts": {
    "clean:build": "node scripts/clean-build.mjs",
    "build": "pnpm run clean:build && tsc -p tsconfig.build.json && tsdown",
    "bundle": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "pack:check": "node scripts/check-pack.mjs",
    "loader:smoke": "node scripts/check-loader.mjs",
    "client-loader:smoke": "node scripts/check-client-loader.mjs",
    "install:smoke": "node scripts/check-install.mjs",
    "prototype:settings": "node prototype/serve.mjs",
    "check": "pnpm run test && pnpm run typecheck && pnpm run build && pnpm run loader:smoke && pnpm run client-loader:smoke && pnpm run pack:check && pnpm run install:smoke"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-api-remotes": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-locale": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-store": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-session": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-commands": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-session-projection": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-settings": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-skill": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-subagent": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-alpha.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/cordis-plugin-include": "1.0.7",
    "@deepseek-ai/cordis-plugin-loader": "1.0.3",
    "@deepseek-ai/dsh-agent": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-api-remotes": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-locale": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-modules": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-store": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-session": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-commands": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-invariants": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-session-projection": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-settings": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-skill": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-subagent": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-alpha.3",
    "@types/node": "22.15.0",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "lightningcss": "1.33.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.22.2",
    "typescript": "5.9.3",
    "vitest": "4.1.8"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.2",
    "@dietrichgebert/ponytail": "4.9.0",
    "zod": "4.5.4"
  },
  "packageManager": "pnpm@11.7.0"
}
